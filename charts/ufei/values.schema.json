{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "probes"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "protocol"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "protocol": {"enum": ["http", "https", "tcp", "icmp"]},
          "ip": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "path": {"type": "string", "pattern": "^/"},
          "url": {"type": "string", "minLength": 1},
          "timeout": {"type": "string", "minLength": 1}
        }
      }
    },
    "egressIPNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "maxLength": 253
      }
    },
    "recoveryEnabled": {"type": "boolean"},
    "metricsPrefix": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$", "maxLength": 63},
    "interval": {"type": "string", "minLength": 1},
    "timeout": {"type": "string", "minLength": 1},
    "failureThreshold": {"type": "integer", "minimum": 1},
    "minTimeouts": {"type": "integer", "minimum": 1},
    "cooldown": {"type": "string", "minLength": 1},
    "apiTimeout": {"type": "string", "minLength": 1},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "interval": {"type": "string", "minLength": 1},
        "scrapeTimeout": {"type": "string", "minLength": 1}
      }
    },
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "required": ["recoveryEnabled"],
        "properties": {"recoveryEnabled": {"const": true}}
      },
      "then": {
        "properties": {
          "egressIPNames": {"minItems": 1},
          "probes": {"minItems": 2},
          "minTimeouts": {"minimum": 2}
        }
      }
    }
  ]
}
